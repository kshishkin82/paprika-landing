# Скопируйте в .env и поменяйте значения.
PORT=3000
# Пароль входа в /admin. Если не задан — пароль хранится в базе
# (при первом запуске генерируется и печатается в консоль; сменить: npm run password -- <новый>).
ADMIN_PASSWORD=change-me
# Часовой пояс для «ближайших» дат мастер-классов.
SITE_TZ=Europe/Volgograd
# 1 — ставить cookie с флагом Secure (включите, если сайт за HTTPS).
COOKIE_SECURE=0
# Адрес сайта — для ссылки «Все заявки» в уведомлениях.
SITE_URL=https://paprika-studio.ru

# ---------- Уведомления о новых заявках (подробно: docs/notifications.md) ----------
# Канал включается, когда заполнены его обязательные поля. Проверка: npm run notify:test

# Telegram: токен от @BotFather и ID чата (узнать: npm run notify:ids)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# MAX: токен бота из кабинета «MAX для партнёров» и получатель —
# MAX_CHAT_ID (групповой чат) ИЛИ MAX_USER_ID (личка). Узнать ID: npm run notify:ids
MAX_BOT_TOKEN=
MAX_CHAT_ID=
MAX_USER_ID=
# Сертификат Минцифры для API MAX (по умолчанию — приложенный certs/russian_trusted_root_ca.pem)
# MAX_CA_FILE=certs/russian_trusted_root_ca.pem

# Почта (SMTP). Для Яндекса/Mail.ru/Gmail нужен «пароль приложения», не обычный пароль.
#   Яндекс:  smtp.yandex.ru, 465   ·   Mail.ru: smtp.mail.ru, 465   ·   Gmail: smtp.gmail.com, 465
SMTP_HOST=
SMTP_PORT=465
# 1 — TLS сразу (465), 0 — STARTTLS (587). Пусто — по номеру порта.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Отправитель (обычно тот же ящик, что SMTP_USER). Пусто — «Paprika Studio <SMTP_USER>».
MAIL_FROM=
# Кому слать заявки, можно несколько через запятую
MAIL_TO=
