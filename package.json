{
  "name": "paprika-landing",
  "version": "2.0.0",
  "description": "Paprika Studio — лендинг и простая CMS (Node.js + SQLite, без зависимостей)",
  "private": true,
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env server.js",
    "dev": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env --watch server.js",
    "password": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env server/set-password.js",
    "notify:test": "node --env-file-if-exists=.env server/notify-cli.js test",
    "notify:ids": "node --env-file-if-exists=.env server/notify-cli.js ids"
  }
}
